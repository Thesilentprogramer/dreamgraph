# Railway → HydraDB service → variables.
# Replace the bucket endpoint, keys, and token with the Railway bucket and a generated secret.
# AWS_ALLOW_HTTP is true only for an http:// endpoint. A https:// Railway endpoint stays false.

CLOUD_PROVIDER=aws
AWS_BUCKET_NAME=${{bucket.AWS_S3_BUCKET}}
AWS_DEFAULT_REGION=${{bucket.AWS_DEFAULT_REGION}}
AWS_ENDPOINT=${{bucket.AWS_ENDPOINT_URL}}
AWS_ACCESS_KEY_ID=${{bucket.AWS_ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{bucket.AWS_SECRET_ACCESS_KEY}}
AWS_ALLOW_HTTP=false
AWS_EC2_METADATA_DISABLED=true

GRAPH_ALLOW_PLAINTEXT=true
GRAPH_AUTH_TOKEN=replace-with-a-long-random-token
GRAPH_NAMESPACE=default
GRAPH_ID=default
GRAPH_CELL_ID=cell-0
GRAPH_CELLS=cell-0
GRAPH_NODE_ID=node-0
GRAPH_BOLT_NODE_ADDRESSES=node-0=0.0.0.0:7687
GRAPH_DATA_CACHE_DIR=/var/cache/slatedb
RUST_MIN_STACK=33554432

# The published image reads the token from a file, GRAPH_AUTH_TOKEN_FILE.
# Railway's UI does not mount that file for you. Write it at start, for example
# a custom start command:
#   sh -c 'umask 077; printf %s "$GRAPH_AUTH_TOKEN" > /tmp/auth-token; export GRAPH_AUTH_TOKEN_FILE=/tmp/auth-token; exec graph-node'
# Confirm the image's entrypoint is graph-node before you rely on that line.
