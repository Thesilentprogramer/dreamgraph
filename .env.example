# Local and Render. Nothing here is a production credential.
# HYDRADB_AUTH_TOKEN is the bearer the dashboard and graph-node share.
# The default is HydraDB's published local-development token, not a secret.
# On Render, render.yaml generates a fresh value instead of using this default.

PORT=8000
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
DG_HYDRA_URL=http://127.0.0.1:8443
DG_SEED_ON_BOOT=0

# moto defaults used inside the container. Not AWS account keys.
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=dreamgraph
